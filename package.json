{
  "name": "sla-monitoring-case-study",
  "version": "1.0.0",
  "description": "SLA Monitoring Dashboard with Vercel Serverless & MongoDB Atlas",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm --prefix client run dev",
    "dev:api": "node --watch api/localDevServer.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
